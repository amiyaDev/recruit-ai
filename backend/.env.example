# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruit_ai

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# OpenAI key used for ATS suggestions, interview generation/evaluation, and chat
OPENAI_API_KEY=

# Hard ceiling on total estimated OpenAI spend (see services/usage_tracker.py)
MAX_LLM_SPEND_USD=4.50

# Comma-separated origins allowed to call this API, as a JSON array
CORS_ORIGINS=["http://localhost:3000"]

# Qdrant vector DB — local docker-compose default shown; for Qdrant Cloud use
# https://<cluster>.cloud.qdrant.io:6333 and set QDRANT_API_KEY
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
